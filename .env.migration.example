# Migration-only DB config, kept SEPARATE from the app's .env.<env> files. Read ONLY by scripts/migrate.py.
# One full DSN per target; `--target <name>` picks POSTGRES_DSN_<NAME> (default: local).
# Copy to .env.migration (gitignored) and fill in. If dev/prod DBs sit behind a private network, use the
# tunnelled host/port here, not the docker-internal one the app config uses.

POSTGRES_DSN_LOCAL=postgresql://postgres:postgres@localhost:5432/biveit
POSTGRES_DSN_DEV=
POSTGRES_DSN_PROD=
