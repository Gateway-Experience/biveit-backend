# {{{host}}}: project {{{project_id}}}'s production site, written by biveit (modules/deployments). Rewritten at
# every deploy -- don't edit it here. Its certificate is the domain's own from certbot (webroot), or our wildcard
# one for a subdomain of ours.
server {
    listen 80;
    listen [::]:80;
    server_name {{{host}}};

    # certbot's renewals answer here, so this stays on plain http.
    location /.well-known/acme-challenge/ {
        root {{{settings.certbot_webroot}}};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{{host}}};

    ssl_certificate /etc/letsencrypt/live/{{{cert_name}}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{{cert_name}}}/privkey.pem;
    client_max_body_size 20m;

    # The site's container, which serves everything (its own nginx routes /api/).
    location / {
        proxy_pass http://127.0.0.1:{{{site_port}}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, never append: the backend trusts the first hop as the client IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
    }
}
