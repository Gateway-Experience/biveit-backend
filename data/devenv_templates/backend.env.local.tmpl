# The project's backend in DEV, written once by vib3 when implementing started (never overwritten --
# edit freely). .env.local is the file the boilerplate's config always loads; ENV below is what it reads
# as its environment name. (Not set through pm2: pm2 turns its app config keys into env vars, so an
# `env: {...}` there arrives as env=[object Object].)
ENV=dev
APP_NAME=project_{{{project_id}}}
# Only nginx (and the Vite proxy) reach it -- never the public interface.
API_HOST=127.0.0.1
API_PORT={{{dev_backend_port}}}
API_RELOAD=true

# Shared Mongo user; this project's dev database.
MONGO_URI={{{settings.project_mongo_uri}}}
MONGO_DB=db_project_dev_{{{project_id}}}

# This project's own Redis database for dev (nobody else's keys in it).
REDIS_URL={{{settings.project_redis_url}}}/{{{dev_redis_db}}}

# Derived per project -- the prod env file gets the same values.
JWT_SECRET={{{secret("jwt_secret")}}}
JWT_EXPIRY_SECONDS=1296000
ADMIN_TOKEN={{{secret("admin_token")}}}
MASTER_PASSWORD=

CORS_ALLOWED_ORIGINS={{{dev_url}}}
