# The project's backend in DEV, written once by vib3 when implementing started (never overwritten --
# edit freely). .env.local is the file the boilerplate's config always loads; ENV below is what it reads
# as its environment name. (Not set through pm2: pm2 turns its app config keys into env vars, so an
# `env: {...}` there arrives as env=[object Object].)
ENV=dev
APP_NAME=project_{{{project_id}}}
# It runs in the project's container: 0.0.0.0 there is only reachable through the port the container
# publishes on the host's 127.0.0.1, so still only nginx (and the Vite proxy) reach it. The port is the
# container's own, the same in every project.
API_HOST=0.0.0.0
API_PORT={{{container_backend_port}}}
API_RELOAD=true

# The owner's own Mongo user (it can't see other users' databases); this project's dev database.
MONGO_URI={{{dev_mongo_uri()}}}
MONGO_DB=db_project_dev_{{{project_id}}}

# The project's own Redis, running in its container (pm2's project_<id>_redis): nobody else's keys in it.
REDIS_URL=redis://127.0.0.1:6379/0

# Derived per project -- the prod env file gets the same values.
JWT_SECRET={{{secret("jwt_secret")}}}
JWT_EXPIRY_SECONDS=1296000
ADMIN_TOKEN={{{secret("admin_token")}}}
MASTER_PASSWORD=

CORS_ALLOWED_ORIGINS={{{dev_url}}}
