// pm2 processes for project {{{project_id}}} in DEV, run by pm2 INSIDE the project's container: the backend
// (uvicorn, reloads itself on save), the frontend (Vite dev server, hot reload) and the project's own Redis.
// Written by biveit and rewritten whenever the servers are started -- don't edit it here, it won't stick.
//
// pm2's own `watch` stays OFF: both servers already reload themselves, and pm2 watching too would turn
// every save into a full restart (killing Vite's hot reload).
// Limits: the servers run under `nice -n 10`, so the agent wins when the container is busy, and pm2
// restarts either one that grows past max_memory_restart. The container itself has its own limits.
const path = require('node:path');

module.exports = {
  apps: [
    {
      name: 'project_{{{project_id}}}_be',
      cwd: path.join(__dirname, 'backend'),
      script: 'nice',
      args: '-n 10 uv run python main.py',
      interpreter: 'none',
      // Its settings come from backend/.env.local. No `env:` key here: pm2 exports every app config key as
      // an env var, so it would arrive as env=[object Object] and override the file.
      out_file: path.join(__dirname, 'logs/be.log'),
      error_file: path.join(__dirname, 'logs/be.log'),
      time: true,
      max_memory_restart: '1G',
      // A backend that dies right at startup (bad import, bad env) retries with growing delays instead
      // of spinning.
      exp_backoff_restart_delay: 1000,
    },
    {
      name: 'project_{{{project_id}}}_fe',
      cwd: path.join(__dirname, 'frontend'),
      script: 'nice',
      // --strictPort: fail rather than quietly take another port than the one the container publishes.
      // --host 0.0.0.0: the published port arrives on the container's network interface, not its localhost.
      args: '-n 10 node_modules/.bin/vite --host 0.0.0.0 --port {{{container_frontend_port}}} --strictPort',
      interpreter: 'none',
      out_file: path.join(__dirname, 'logs/fe.log'),
      error_file: path.join(__dirname, 'logs/fe.log'),
      time: true,
      max_memory_restart: '1G',
      exp_backoff_restart_delay: 1000,
    },
    {
      // The project's own Redis: only reachable inside the container (127.0.0.1), capped so a project
      // filling it gets keys evicted rather than the container's memory eaten. Its data lives in the project
      // folder, so it survives the container being recreated.
      name: 'project_{{{project_id}}}_redis',
      script: 'redis-server',
      args: [
        '--bind', '127.0.0.1', '--port', '6379',
        '--dir', path.join(__dirname, '..', '.devenv', 'redis'),
        '--maxmemory', '128mb', '--maxmemory-policy', 'allkeys-lru',
      ].join(' '),
      interpreter: 'none',
      out_file: path.join(__dirname, 'logs/redis.log'),
      error_file: path.join(__dirname, 'logs/redis.log'),
      time: true,
      exp_backoff_restart_delay: 1000,
    },
  ],
};
