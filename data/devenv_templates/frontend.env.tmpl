# The project's frontend, written once by vib3 when implementing started (never overwritten -- edit freely).
# Same origin as the backend (nginx routes /api/), so no domain is baked in.
VITE_API_BASE_URL=/api
# Where the Vite dev server proxies /api/ to, for when the site is opened straight on the Vite port: the
# backend, in the same container.
VITE_API_PROXY_TARGET=http://127.0.0.1:{{{container_backend_port}}}
# The dev site's host name, which Vite must be told to accept (empty when there's no dev domain).
VITE_ALLOWED_HOSTS={{{dev_host or ""}}}
VITE_PROJECT_NAME=project_{{{project_id}}}
VITE_GOOGLE_CLIENT_ID=
VITE_APP_LANGUAGE=en
VITE_MIXPANEL_TOKEN=
VITE_CREATE_GUEST_ACCOUNT=false
VITE_PROMOTE_GUEST_ACCOUNT=false
