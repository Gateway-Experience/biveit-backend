# Environment config. Real env files hold secrets and are listed EXPLICITLY rather than globbed as
# .env.* -- a glob would also swallow any *.example template you add later, which is exactly the file
# that's meant to be committed.
.env
.env.local*
.env.dev
.env.prod
.env.canary
.env.test
.env.migration

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches / local tool artifacts (Playwright MCP snapshots hold real emails + OAuth URLs)
.playwright-mcp/
.pytest_cache/
.ruff_cache/

# File storage (STORAGE_DIR) -- user project files, never committed
data/storage_root/
data/agent2_sockets/

# The agent template's Claude settings ARE committed: a fresh clone needs them (enableAllProjectMcpServers,
# or every session stops at startup to ask about its MCP). Re-included because settings.local.json is
# commonly ignored globally (core.excludesFile) -- this repo's .gitignore takes precedence over that.
!data/template/.claude/settings.local.json
