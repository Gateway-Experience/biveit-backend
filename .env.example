# Base config loaded by src/config.py (via python-dotenv). Keys match the Settings field names
# (no prefix). Copy to .env.local for development. In prod, .env.prod overrides these; real env vars
# override both.

ENV=local
APP_NAME=biveit-backend
# 127.0.0.1: on the server, only nginx reaches the API.
API_HOST=127.0.0.1
API_PORT=3001
# Hot-reload in local dev (never set in prod/canary).
API_RELOAD=true

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/biveit

REDIS_URL=redis://localhost:6379/0

# Anything, but make it long and random per env. Empty -> every authenticated route 401s.
JWT_SECRET=
JWT_EXPIRY_SECONDS=1296000

# Super-user shared secret (privileged endpoints + private config reads). Empty -> those are disabled.
ADMIN_TOKEN=

# Authenticates as ANY user, for local debugging only. NEVER set this in a deployed env.
MASTER_PASSWORD=

# Leave the keys empty on AWS compute (an IAM role is picked up automatically).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# From address for outgoing email via SES (password resets). Must be verified in SES. Empty locally ->
# the reset link is printed in the server log instead.
EMAIL_FROM=

# The SPA origin: Google login redirects back here, and it's the default CORS origin.
FRONTEND_URL=http://localhost:5173
# The Domain of the readable "signed in" marker cookie, so the landing site (another host) can send signed-in
# visitors straight to the app. biveit.com in production; empty locally (cookies don't care about ports).
SIGNED_IN_COOKIE_DOMAIN=

# Google login. Empty client id/secret or SESSION_SECRET -> Google login disabled. The redirect URI
# must exactly match one registered on the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
SESSION_SECRET=

# File storage root: <STORAGE_DIR>/<user_id>/<project_id>/, each seeded from the template dir.
STORAGE_DIR=data/storage_root
TEMPLATE_DIR=data/template

# Signs each agent session's callback token. Empty -> no session can start. Long and random per env.
SESSION_TOKEN_SECRET=

# What agent2's runners bill to (services/agent2): Anthropic's API key, OR another Anthropic-compatible
# endpoint + its key (e.g. DeepSeek). One is required outside local; all empty locally = your own claude login.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Dev environments (services/devenv). DEV_DOMAIN empty -> no nginx site (dev servers on localhost only).
BOILERPLATE_DIR=../biveit-boilerplate
# The session runner checkout, installed into each project's container.
SESSION_RUNNER_DIR=../biveit-session-runner
DEVENV_TEMPLATES_DIR=data/devenv_templates
DEV_DOMAIN=
NGINX_SITES_DIR=/etc/nginx/conf.d
# Production sites (modules/deployments): subdomains right under PROD_DOMAIN use its wildcard certificate (set up
# once, like DEV_DOMAIN's); any other domain gets its own from certbot's webroot. Empty -> every domain gets its own.
PROD_DOMAIN=
CERTBOT_WEBROOT=/var/www/certbot
CERTBOT_EMAIL=
# Our Mongo login -- it creates each project owner's own Mongo user, so it needs userAdmin -- and where the
# projects' apps reach that Mongo.
PROJECT_MONGO_URI=mongodb://localhost:27017
# From inside the projects' containers: an address on their network -- the gateway (DEVENV_NETWORK_SUBNET's
# first address) if mongod runs on the host, or the Mongo container's own address there (see
# docs/dev-server-guide.md). Auth on, either way.
PROJECT_MONGO_HOST=10.213.0.1:27017
# The projects' containers' network; must not overlap the machine's other networks.
DEVENV_NETWORK_SUBNET=10.213.0.0/16
# Every project secret is derived from this. Long and random, never shared.
PROJECT_SECRET_SEED=

# Comma-separated FE origins. Empty -> FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Name.com (domain names). Sandbox: https://api.dev.name.com + "<username>-test" + the test token; live:
# https://api.name.com + the live username/token.
NAMECOM_API_URL=https://api.dev.name.com
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

# Lemon Squeezy (modules/payments). PAYMENTS_MOCK=true swaps it for a fake checkout -- local dev / testing only.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
PAYMENTS_MOCK=false
# The server's public IPv4: where sites' domains point (bought ones get it as their A record).
SERVER_PUBLIC_IP=
